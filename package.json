{
  "name": "primigenius",
  "version": "1.2.0",
  "main": "main.js",
  "description": "Bioinformatics Analysis Tool with Built-in Container Runtime",
  "author": "生信美学",
  "scripts": {
    "build:ui": "node node_modules/typescript/bin/tsc -p tsconfig.vector.json && node build/build_preview.js",
    "prestart": "npm run build:ui",
    "start": "electron .",
    "dist": "python -B build/build_installer.py",
    "runtime:verify": "python -B runtime/bundle.py --verify",
    "dist:release": "python -B build/build_installer.py --release"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "3dmol": "2.5.5",
    "dompurify": "3.4.17",
    "geotiff": "3.0.5",
    "igv": "3.8.10",
    "openseadragon": "6.1.1",
    "tabulator-tables": "6.7.1"
  },
  "build": {
    "appId": "com.primigenius.framework",
    "productName": "PrimiGenius",
    "artifactName": "PrimiGenius-Setup-${version}.${ext}",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist_output",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "src/**/*",
      "package.json",
      "!plugins/**/*",
      "!backend/**/*",
      "!build/**/*",
      "!r_libs/**/*",
      "!r_libs_*/**/*",
      "!outputs/**/*",
      "!podman-data/**/*",
      "!podman-config/**/*",
      "!podman-data-dev/**/*",
      "!podman-config-dev/**/*",
      "!dist/**/*",
      "!podman-5.8.2/**/*",
      "!bin{,/**/*}",
      "!include{,/**/*}",
      "!lib{,/**/*}",
      "!lib64{,/**/*}",
      "!pyvenv.cfg",
      "!*.md",
      "!*.spec",
      "!*.bat",
      "!*.ps1",
      "!.git/**/*",
      "!node_modules/.cache/**/*",
      "!test_data.tsv"
    ],
    "extraResources": [
      {
        "from": "runtime/r-environment",
        "to": "r-environment",
        "filter": [
          "manifest.json",
          "packages.txt",
          "r-packages.txt",
          "licenses.tar.gz",
          "Containerfile",
          "build.Containerfile",
          "stage/environment.tar.gz",
          "stage/environment.tar.xz"
        ]
      },
      {
        "from": "backend/dist/app",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "runtime/release",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/wsl.2.7.3.0.x64.msi",
        "to": "wsl.2.7.3.0.x64.msi"
      },
      {
        "from": "build/jre8.zip",
        "to": "jre8.zip"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrimiGenius"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jianbai-design",
        "repo": "PrimiGenius"
      }
    ]
  },
  "dependencies": {
    "docx-preview": "0.4.1",
    "electron-updater": "^6.8.3",
    "iconv-lite": "^0.7.2",
    "marked": "^4.3.0",
    "saxes": "6.0.0",
    "tar": "6.2.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0"
  }
}
